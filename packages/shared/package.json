{
  "name": "@sureground/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "types": "./src/types/index.ts"
    },
    "./constants": {
      "import": "./src/constants/index.ts",
      "types": "./src/constants/index.ts"
    },
    "./address": {
      "import": "./src/utils/address.ts",
      "types": "./src/utils/address.ts"
    },
    "./utils": {
      "import": "./src/utils/index.ts",
      "types": "./src/utils/index.ts"
    },
    "./showroom": {
      "import": "./src/showroom/index.ts",
      "types": "./src/showroom/index.ts"
    },
    "./csp": {
      "import": "./src/utils/csp.ts",
      "types": "./src/utils/csp.ts"
    },
    "./auth": {
      "import": "./src/auth/index.ts",
      "types": "./src/auth/index.ts"
    },
    "./constants/app-links.json": "./src/constants/app-links.json"
  },
  "scripts": {
    "build": "echo 'No build step yet'",
    "dev": "echo 'No dev step yet'",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --import ./test/register.mjs --test test/*.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sureground/eslint-config": "workspace:*",
    "@sureground/typescript-config": "workspace:*",
    "@types/node": "^22.19.20",
    "date-fns": "^3.6.0",
    "typescript": "^5.4.5",
    "eslint": "^9.39.4"
  }
}
