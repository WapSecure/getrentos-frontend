{
  "name": "@sureground/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./styles": {
      "style": "./src/styles/index.css",
      "import": "./src/styles/index.css",
      "default": "./src/styles/index.css"
    },
    "./providers/*": {
      "import": "./src/providers/*.tsx",
      "types": "./src/providers/*.tsx"
    },
    "./*": {
      "import": "./src/*.tsx",
      "types": "./src/*.tsx"
    }
  },
  "scripts": {
    "build": "echo 'No build step yet'",
    "dev": "echo 'No dev step yet'",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@sureground/icons": "workspace:*",
    "@sureground/shared": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.0.0",
    "hls.js": "^1.7.4",
    "next-themes": "^0.4.6"
  },
  "devDependencies": {
    "@sureground/eslint-config": "workspace:*",
    "@sureground/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.4.5"
  }
}
