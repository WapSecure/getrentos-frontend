NEXT_PUBLIC_API_URL=http://localhost:4000

# Error monitoring. Leave both empty to keep Sentry off: nothing loads or sends, and the CSP stays closed to it.
# NEXT_PUBLIC_SENTRY_DSN is inlined at build time (browser + CSP); SENTRY_DSN is read by the server at runtime.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
