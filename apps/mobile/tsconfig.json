{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@getrentos/shared": ["../../packages/shared/src/index.ts"],
      "@getrentos/shared/*": ["../../packages/shared/src/*"],
      "@getrentos/tokens": ["../../packages/tokens/src/index.ts"],
      "@getrentos/ui-native": ["../../packages/ui-native/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
