{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["react"],
    "paths": {
      "@/*": ["./*"],
      "react-native": ["./node_modules/react-native"],
      "@sureground/shared": ["../../packages/shared/src/index.ts"],
      "@sureground/shared/*": ["../../packages/shared/src/*"],
      "@sureground/tokens": ["../../packages/tokens/src/index.ts"],
      "@sureground/ui-native": ["../../packages/ui-native/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "__tests__"]
}
