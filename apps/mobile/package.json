{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --go",
    "go": "expo start --go",
    "dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "preview": "expo start --web --port 8081",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest --watch",
    "test:ci": "jest --runInBand --no-watchman",
    "quality": "pnpm type-check && pnpm type-check:test && pnpm lint && pnpm test:ci",
    "go:offline": "expo start --go --offline",
    "go:tunnel": "expo start --go --tunnel"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.3",
    "@expo/dom-webview": "^58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@hookform/resolvers": "^5.9.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@smileid/usesmileid": "^12.4.0",
    "@smileid/usesmileid_mlkit_face": "^12.4.0",
    "@smileid/usesmileid_vision_face": "^12.4.0",
    "@sureground/shared": "workspace:*",
    "@sureground/tokens": "workspace:*",
    "@sureground/ui-native": "workspace:*",
    "@tanstack/query-async-storage-persister": "5.102.8",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-persist-client": "5.102.8",
    "babel-preset-expo": "~58.0.24",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-brightness": "~58.0.2",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "^57.1.1",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "jpeg-js": "0.4.4",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^1.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-passkey": "3.6.2",
    "react-native-purchases": "^10.10.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@sureground/shared$": "<rootDir>/../../packages/shared/src/index.ts",
      "^@sureground/tokens$": "<rootDir>/../../packages/tokens/src/index.ts",
      "^@sureground/ui-native$": "<rootDir>/../../packages/ui-native/src/index.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|expo-router|standard-navigation|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup-globals.js"
    ]
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  }
}
