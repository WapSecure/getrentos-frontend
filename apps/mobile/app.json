{
  "expo": {
    "name": "GetRentos",
    "slug": "getrentos",
    "version": "1.0.0",
    "scheme": "getrentos",
    "orientation": "portrait",
    "icon": "./assets/icon-premium.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-premium.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f7f9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getrentos.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.getrentos.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5FAFF",
        "foregroundImage": "./assets/icon-premium.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "GetRentos needs access to your photos and videos to attach documents and add them to your listings.",
          "cameraPermission": "GetRentos needs camera access to take a selfie for identity verification and to film property tours.",
          "microphonePermission": "GetRentos needs the microphone to record sound with a property video tour."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f7f9",
          "image": "./assets/icon-premium.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0a0c11"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "GetRentos uses the camera to scan a visitor's QR pass at the gate."
        }
      ],
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "color": "#0071E3",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "GetRentos uses Face ID to unlock the app when you turn on the app lock."
        }
      ],
      "expo-apple-authentication",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GetRentos checks you are at the property when you film its video tour, so buyers and renters see it was filmed on site."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
