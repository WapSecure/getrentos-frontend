{
  "expo": {
    "name": "Sureground",
    "slug": "getrentos",
    "version": "1.0.0",
    "scheme": "sureground",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.getsureground.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "io.getsureground.app",
      "adaptiveIcon": {
        "backgroundColor": "#0057D9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sureground uses the microphone when you speak a question to Ask Sureground.",
          "speechRecognitionPermission": "Sureground turns what you say into text so you can check it before sending.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sureground needs access to your photos and videos to attach documents and add them to your listings.",
          "cameraPermission": "Sureground needs camera access to take a selfie for identity verification and to film property tours.",
          "microphonePermission": "Sureground needs the microphone to record sound with a property video tour."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f7f8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Sureground uses the camera to scan a visitor's QR pass at the gate."
        }
      ],
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "color": "#0071E3",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sureground uses Face ID to unlock the app when you turn on the app lock."
        }
      ],
      "expo-apple-authentication",
      "expo-video",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sureground checks you are at the property when you film its video tour, so buyers and renters see it was filmed on site."
        }
      ],
      [
        "@smileid/usesmileid_mlkit_face",
        {
          "kspVersion": "2.3.6"
        }
      ],
      "@smileid/usesmileid_vision_face"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cc26d00-7ec0-4251-8c6e-ce49aae8510a"
      }
    },
    "owner": "wapsecure",
    "newArchEnabled": true
  }
}
