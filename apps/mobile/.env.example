# Public runtime configuration
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_URL=https://getrentos.com
EXPO_PUBLIC_SENTRY_DSN=

# Configure SENTRY_AUTH_TOKEN, SENTRY_ORG, and SENTRY_PROJECT as protected EAS/CI
# secrets. Do not commit their values.
# In-app Pro purchases (RevenueCat public SDK keys; safe to ship in the app).
# Leave empty to hide in-app purchase.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Map tiles: a Mapbox PUBLIC token (pk.…), URL-restricted in the Mapbox dashboard.
# Leave empty to use OpenStreetMap tiles (fine for development only).
EXPO_PUBLIC_MAPBOX_TOKEN=

# Support contacts shown in the app. Phone/WhatsApp/hours lines stay hidden until set.
EXPO_PUBLIC_SUPPORT_EMAIL=support@getrentos.com
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_HOURS=
