{
  "name": "getrentos",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:backoffice": "pnpm --filter backoffice dev",
    "dev:all": "pnpm run dev:web & pnpm run dev:backoffice",
    "build:web": "pnpm --filter web build",
    "build:mobile": "pnpm --filter mobile build",
    "build:backoffice": "pnpm --filter backoffice build",
    "build:shared": "pnpm --filter @getrentos/shared build",
    "build:all": "pnpm run build:shared && pnpm run build:web && pnpm run build:backoffice",
    "clean": "pnpm -r clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18"
  }
}
