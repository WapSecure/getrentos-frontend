{
  "name": "sureground",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "tokens:sync": "node --experimental-strip-types scripts/sync-design-tokens.mts",
    "tokens:check": "node --experimental-strip-types scripts/sync-design-tokens.mts --check",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:backoffice": "pnpm --filter backoffice dev",
    "dev:all": "pnpm run dev:web & pnpm run dev:backoffice",
    "build:web": "pnpm --filter web build",
    "build:mobile": "pnpm --filter mobile build",
    "build:backoffice": "pnpm --filter backoffice build",
    "build:shared": "pnpm --filter @sureground/shared build",
    "quality:mobile": "pnpm --filter mobile quality",
    "build:all": "pnpm run build:shared && pnpm run build:web && pnpm run build:backoffice",
    "test:e2e": "playwright test",
    "test:e2e:agent-sync": "playwright test --config=playwright.agent-sync.config.ts",
    "test:e2e:design": "playwright test --config=playwright.design.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:visual:report": "playwright show-report playwright-visual-report",
    "test:e2e:visual:update": "E2E_VISUAL_COMPARE=1 playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:e2e:visual:compare": "E2E_VISUAL_COMPARE=1 playwright test --config=playwright.visual.config.ts",
    "preflight:feature": "node scripts/repo-preflight.mjs feature",
    "validate:dev-sync": "node scripts/repo-preflight.mjs dev-sync",
    "icons:migrate": "node scripts/icons-migrate.mjs",
    "icons:check": "node scripts/icons-migrate.mjs --check",
    "audit:ui-controls": "node scripts/ui-control-audit.mjs",
    "audit:ui-controls:update": "node scripts/ui-control-audit.mjs --update",
    "clean": "pnpm -r clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=22.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ],
    "overrides": {
      "react-native-worklets": "0.13.0",
      "@expo/dom-webview": "^58.0.2",
      "whatwg-fetch": "3.6.20",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "react-native": "0.88.1",
      "react-native-safe-area-context": "5.11.1",
      "react-native-screens": "4.30.1",
      "react-native-reanimated": "4.7.1",
      "react-native-gesture-handler": "3.3.0",
      "react-native-svg": "15.16.0",
      "expo-image": "58.0.18",
      "@xmldom/xmldom@>=0.8.0 <0.9.0": "^0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.10.0": "^0.9.12",
      "brace-expansion@>=1.0.0 <2.0.0": "^1.1.20",
      "brace-expansion@>=5.0.0 <6.0.0": "^5.0.11",
      "js-yaml@>=4.0.0 <5.0.0": "^4.3.2",
      "browserslist@>=4.0.0 <5.0.0": "^4.28.7",
      "shell-quote@>=1.0.0 <2.0.0": "^1.11.0",
      "node-forge@>=1.0.0 <2.0.0": "^1.4.1",
      "source-map-js@>=1.0.0 <2.0.0": "^1.2.2",
      "compression@>=1.0.0 <2.0.0": "^1.8.2"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "*"
        }
      }
    }
  }
}
