{
  "name": "getrentos",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:backoffice": "pnpm --filter backoffice dev",
    "dev:all": "pnpm run dev:web & pnpm run dev:backoffice",
    "build:web": "pnpm --filter web build",
    "build:mobile": "pnpm --filter mobile build",
    "build:backoffice": "pnpm --filter backoffice build",
    "build:shared": "pnpm --filter @getrentos/shared build",
    "build:all": "pnpm run build:shared && pnpm run build:web && pnpm run build:backoffice",
    "clean": "pnpm -r clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "react-native-worklets": "0.10.1",
      "@expo/dom-webview": "^57.0.1",
      "whatwg-fetch": "3.6.20",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native": "0.86.3",
      "react-native-safe-area-context": "5.7.0",
      "react-native-screens": "4.26.2",
      "react-native-reanimated": "4.5.1",
      "react-native-gesture-handler": "2.32.0",
      "react-native-svg": "15.15.4",
      "expo-image": "57.0.4"
    }
  }
}
